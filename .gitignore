# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.next/

# production
/build
/dist

# env — NEVER commit these. Use .env.example as a template.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
.env.production
.env.development

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sanity studio — built artifacts, never commit
/dist
/.sanity

# turbo
.turbo

# local fs caches
.cache
.tmp
