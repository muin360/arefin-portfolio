# --------------------------------------------------------------------
# Arefin Mueen Portfolio — Environment Variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in real
# values. Do NOT commit `.env.local`.
# --------------------------------------------------------------------

# ---- Site ---------------------------------------------------------------

# Canonical site URL — used for og:url, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tensorix.me

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- MongoDB Atlas (Persistent Database) --------------------------------

# Server-only MongoDB connection URI. NEVER prefix with NEXT_PUBLIC_.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DB_NAME="arefin_portfolio"

# ---- Contact (used in fallbacks + WhatsApp FAB + email) ----------------

# Display phone (with formatting).
CONTACT_PHONE=+880 1994-605717
# E.164 digits only — used for wa.me URLs and tel: links.
CONTACT_PHONE_E164=8801994605717
# Pre-filled WhatsApp link.
WHATSAPP_URL=https://wa.me/8801994605717
# Primary public-facing email.
CONTACT_EMAIL=arefinmueen360@gmail.com

# ---- Cal.com booking embed (used on /book) ------------------------------

# Your Cal.com username (e.g. "arefin") — public, embeds in iframe URL.
NEXT_PUBLIC_CAL_USERNAME=
# Optional: event slug. Defaults to "30min" if omitted.
NEXT_PUBLIC_CAL_EVENT=30min

# ---- Email (contact form via Resend) ------------------------------------

# Server-only. Get one at https://resend.com → API Keys.
RESEND_API_KEY=

# Optional sender. Must be a verified domain in Resend.
CONTACT_FROM_EMAIL=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=arefinmueen360@gmail.com

# ---- NextAuth.js & Admin Configuration ----------------------------------

# Generate a secret for session encryption: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# NextAuth URL (production domain)
NEXTAUTH_URL=https://tensorix.me

# Passcode for logging into /admin (Credentials login)
ADMIN_PASSWORD=

# Comma-separated list of GitHub usernames allowed to access admin panel
ADMIN_GITHUB_USERS=muin360

# Comma-separated list of email addresses allowed to access admin panel
ADMIN_EMAILS=arefinmueen360@gmail.com

# ---- GitHub OAuth (https://github.com/settings/developers) --------------

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- Google OAuth (https://console.cloud.google.com/) -------------------

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
