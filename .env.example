# --------------------------------------------------------------------
# Arefin Mueen Portfolio — Environment Variables Configuration
#
# Production Domain: https://tensorstudio.vercel.app
# Copy this file to `.env.local` for local development.
# Set these variables in Vercel → Project Settings → Environment Variables.
# --------------------------------------------------------------------

# ---- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tensorstudio.vercel.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<YOUR_GOOGLE_VERIFICATION_TOKEN>

# ---- MongoDB Atlas (Persistent Database) --------------------------------
# Server-only MongoDB connection URI. NEVER prefix with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DATABASE>?retryWrites=true&w=majority
MONGODB_DB_NAME=arefin_portfolio

# ---- NextAuth.js & Admin Configuration ----------------------------------
# Generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
NEXTAUTH_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
NEXTAUTH_URL=https://tensorstudio.vercel.app

# Passcode for logging into /admin (Credentials login)
ADMIN_PASSWORD=<YOUR_SECURE_ADMIN_PASSCODE>

# Comma-separated list of GitHub usernames and emails allowed to access /admin
ADMIN_GITHUB_USERS=muin360
ADMIN_EMAILS=arefinmueen360@gmail.com

# ---- GitHub OAuth (https://github.com/settings/developers) --------------
AUTH_GITHUB_ID=<YOUR_GITHUB_CLIENT_ID>
AUTH_GITHUB_SECRET=<YOUR_GITHUB_CLIENT_SECRET>

# ---- Google OAuth (https://console.cloud.google.com/) -------------------
AUTH_GOOGLE_ID=<YOUR_GOOGLE_CLIENT_ID>
AUTH_GOOGLE_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# ---- Contact & Social ---------------------------------------------------
CONTACT_EMAIL=arefinmueen360@gmail.com
CONTACT_PHONE=+880 1994-605717
CONTACT_PHONE_E164=8801994605717
WHATSAPP_URL=https://wa.me/8801994605717

# ---- Email Delivery (Contact Form via Resend) ---------------------------
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=arefinmueen360@gmail.com

# ---- Cal.com Booking Embed (/book) --------------------------------------
NEXT_PUBLIC_CAL_USERNAME=
NEXT_PUBLIC_CAL_EVENT=30min
