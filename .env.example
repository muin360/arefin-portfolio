# --------------------------------------------------------------------
# Tensorix — environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in real
# values. Do NOT commit `.env.local`.
#
# Anything prefixed with NEXT_PUBLIC_ is bundled into the client browser
# JavaScript. ONLY put values there that are safe to be public.
# Everything else is server-only and never sent to the browser.
# --------------------------------------------------------------------

# ---- Site ---------------------------------------------------------------

# Canonical site URL — used for og:url, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tensorstudio.vercel.app

# Optional: Google Search Console verification token. After verifying once
# you can leave blank — the meta tag is only emitted if this is set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Contact (used in fallbacks + WhatsApp FAB + email) ----------------

# Display phone (with formatting). Shown in footer, contact page, etc.
CONTACT_PHONE=+880 1994-605717
# E.164 digits only — used for wa.me URLs and tel: links.
CONTACT_PHONE_E164=8801994605717
# Pre-filled WhatsApp link. Override per-deployment if you ever swap numbers.
WHATSAPP_URL=https://wa.me/8801994605717
# Primary public-facing email — shown in footer/contact/privacy/terms.
CONTACT_EMAIL=arefinmueen360@gmail.com

# ---- Cal.com booking embed (used on /book) ------------------------------

# Your Cal.com username (e.g. "arefin") — public, embeds in iframe URL.
NEXT_PUBLIC_CAL_USERNAME=
# Optional: event slug. Defaults to "30min" if omitted.
NEXT_PUBLIC_CAL_EVENT=30min

# ---- Sanity CMS (https://www.sanity.io/) -------------------------------

# Public — required for the studio + frontend to talk to your dataset.
# These are visible in the browser but cannot read private data without
# a token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only — read token for private datasets. Optional. NEVER prefix
# with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Server-only — write token. Used by `npm run sanity:seed` and the
# revalidate webhook. Treat like a password.
SANITY_API_WRITE_TOKEN=

# Server-only — shared secret for the Sanity → /api/revalidate webhook.
# Generate with: `openssl rand -base64 32`
SANITY_REVALIDATE_SECRET=

# ---- Email (contact form via Resend) ------------------------------------

# Server-only. Get one at https://resend.com → API Keys.
RESEND_API_KEY=

# Optional sender. Must be a verified domain in Resend. Until you verify
# your domain, leave blank — the form falls back to onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# Where contact form submissions are delivered. Defaults to CONTACT_EMAIL.
CONTACT_TO_EMAIL=arefinmueen360@gmail.com

# ---- NextAuth.js (OAuth authentication) --------------------------------

# Generate a secret for session encryption
# Run: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# NextAuth URL (production domain)
NEXTAUTH_URL=https://tensorstudio.vercel.app

# ---- GitHub OAuth (https://github.com/settings/developers) -----------

# GitHub OAuth App credentials
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- Google OAuth (https://console.cloud.google.com/) ----------------

# Google OAuth credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Admin Configuration -------------------------------------------------

# Comma-separated list of GitHub usernames allowed to access admin panel
ADMIN_GITHUB_USERS=muin360

# Comma-separated list of email addresses allowed to access admin panel
ADMIN_EMAILS=arefinmueen360@gmail.com
