# --------------------------------------------------------------------
# Local Development Environment Setup (.env.local template)
#
# Duplicate this file to `.env.local` and add your local/test credentials.
# `.env.local` is gitignored and will never be committed to repository.
# --------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net
MONGODB_DB_NAME=arefin_portfolio

# NextAuth / Admin Configuration
AUTH_SECRET=local-development-secret-key-32charsmin
NEXTAUTH_SECRET=local-development-secret-key-32charsmin
NEXTAUTH_URL=http://localhost:3000

# Passcode to log into http://localhost:3000/admin/login
ADMIN_PASSWORD=your-local-passcode
ADMIN_GITHUB_USERS=muin360
ADMIN_EMAILS=arefinmueen360@gmail.com

